#-------------------------------------------------------------------------------
#- common global variables -----------------------------------------------------
__SCRIPT_BASE=$(cd "$(dirname "$0")" && pwd)
__SCRIPT_NAME=$(basename "$0")

#-------------------------------------------------------------------------------
#- global variables ------------------------------------------------------------
_RC_FNAME="cloudflare-dns.conf"
# same search order as cloudflare-dns
_RC_FILES=("./${_RC_FNAME}" "${HOME}/.${_RC_FNAME}" "/etc/${_RC_FNAME}")
_CONF_FILE=
_SLACK_LOADED=
_T_ERR=

#-------------------------------------------------------------------------------
#- common functions ------------------------------------------------------------
#{{{
__show_error() { #{{{
  local MSG="$1"
  echo -e "$MSG" >&2
}
#}}}

__error_end() { #{{{
  __show_error "$1"; exit 1
}
#}}}
#}}}

#-------------------------------------------------------------------------------
#- functions -------------------------------------------------------------------

# read only SLACK_* variables from the config file (sourced in a subshell)
_load_slack_config() { #{{{
  local CONF="$1"
  local F

  if [[ -n "$CONF" ]]; then
    if [[ ! -f "$CONF" ]]; then
      __show_error "Config file is not found. : $CONF"
      exit 2
    fi
  else
    for F in "${_RC_FILES[@]}"; do
      if [[ -f "$F" ]]; then
        CONF="$F"
        break
      fi
    done
  fi
  [[ -z "$CONF" ]] && return 0
  _CONF_FILE="$CONF"

  eval "$(
    # shellcheck source=/dev/null
    source "$CONF" > /dev/null 2>&1
    for V in SLACK_WEBHOOK_URL SLACK_CHANNEL SLACK_USER SLACK_ICON; do
      [[ -n "${!V}" ]] && printf '_%s=%q\n' "$V" "${!V}"
    done
  )"
  [[ -z "$_SLACK_USER" ]] && _SLACK_USER=$(hostname)
  [[ -z "$_SLACK_ICON" ]] && _SLACK_ICON=":ghost:"
  _SLACK_LOADED=yes
}
#}}}

# build a Slack message from the result JSON of "cloudflare-dns sync -o json"
# print nothing if there is no need to send
_build_message() { #{{{
  jq -r --arg silent "$_SILENT" '
    def count($s): [.results[] | select(.status == $s)] | length;
    def line:
      if .status == "updated" then "✅ `\(.name)` : `\(.before.content)` → `\(.after.content)`"
      elif .status == "planned" then "🔜 `\(.name)` : `\(.before.content)` → `\(.after.content)`"
      elif .status == "unchanged" then "➖ `\(.name)` : `\(.after.content)`"
      else "❌ `\(.name)` : \(.error)" end;
    . as $all
    | "Current IP : `\(.value)`" as $ip
    | if count("failed") > 0 then
        "<!channel> Failed to update some DNS records!"
      elif count("updated") > 0 then
        "<!channel> IP address has been changed!"
      elif count("planned") > 0 then
        "<!channel> IP address has been changed! (not updated)"
      else null end
    | if . == null then
        (if $silent == "" then $ip else empty end)
      else
        ([., $ip] + [$all.results[] | line]) | join("\n")
      end
  ' <<<"$1"
}
#}}}

_send_slack() { #{{{
  local MSG="$1"
  [[ -z "$_SLACK_WEBHOOK_URL" ]] && return 0
  local PAYLOAD
  PAYLOAD=$(jq -cn --arg text "$MSG" --arg channel "$_SLACK_CHANNEL" \
    --arg username "$_SLACK_USER" --arg icon "$_SLACK_ICON" \
    '{text: $text, username: $username, icon_emoji: $icon}
       + (if $channel == "" then {} else {channel: $channel} end)')
  curl -sS -X POST -H 'Content-Type: application/json' --data "$PAYLOAD" \
    "$_SLACK_WEBHOOK_URL" > /dev/null \
    || __show_error "Failed to send a message to Slack."
}
#}}}

# report a fatal error to stderr and Slack, then exit (default exit code: 1)
# DETAIL is appended only to the Slack message
_fatal() { #{{{
  local MSG="$1"
  local RC="${2:-1}"
  local DETAIL="$3"
  __show_error "$MSG"
  if [[ -n "$_SLACK_LOADED" ]]; then
    local TEXT="<!channel> ${__SCRIPT_NAME} failed!"$'\n'"${MSG}"
    [[ -n "$DETAIL" ]] && TEXT+=$'\n```\n'"${DETAIL}"$'\n```'
    _send_slack "$TEXT"
  fi
  exit "$RC"
}
#}}}

# shellcheck disable=SC2329 # invoked by trap
_cleanup() { #{{{
  [[ -n "$_T_ERR" ]] && rm -f "$_T_ERR"
}
#}}}

_usage() { #{{{
  [[ "$1" ]] && __show_error "$1"
  cat <<!!!
usage : $__SCRIPT_NAME [-c CONF_FILE] [-u] [-s] [-h]
          -c : config file path (passed through to cloudflare-dns)
               (default: the first one found in ${_RC_FILES[*]})
          -u : update records (without -u: check only = cloudflare-dns sync -N)
          -s : silent on Slack unless something changed or failed
          -h : display usage

[Configuration]
  Records and IP_COMMAND are read by cloudflare-dns from the same config file.
  This script reads only the following variables.

  SLACK_WEBHOOK_URL  : Slack web hook url to send notification (no notification if empty)
  SLACK_CHANNEL      : Slack channel to notify (Should start with '#')
  SLACK_USER         : Slack user name (default: hostname)
  SLACK_ICON         : Slack icon emoji (default: :ghost:)
!!!
  [[ "$1" ]] && exit 2
  exit 0
}
#}}}

#-------------------------------------------------------------------------------
#- Main process ----------------------------------------------------------------
#-------------------------------------------------------------------------------
trap _cleanup EXIT

#- Get options -----------------------------------------------------------------
#{{{
while getopts c:ush OPT; do
  case "$OPT" in
    c) _CONF_OPT="$OPTARG"
      ;;
    u) _UPDATE_DNS=yes
      ;;
    s) _SILENT=yes
      ;;
    h) _usage
      ;;
    \?) _usage "Invalid option."
      ;;
  esac
done
shift $((OPTIND - 1))
#}}}

# errors before loading SLACK_* are reported only to stderr
command -v jq > /dev/null 2>&1 || __error_end "jq executable is not found."
_load_slack_config "$_CONF_OPT"

#- Main process ----------------------------------------------------------------
CF_DNS="${__SCRIPT_BASE}/cloudflare-dns"
[[ -x "$CF_DNS" ]] || _fatal "cloudflare-dns executable is not found. : $CF_DNS"

CF_OPTS=(sync -o json)
[[ -n "$_CONF_FILE" ]] && CF_OPTS+=(-c "$_CONF_FILE")
[[ "$_UPDATE_DNS" != yes ]] && CF_OPTS+=(-N)

_T_ERR=$(mktemp) || _fatal "Failed to create a temporary file."
OUT=$("$CF_DNS" "${CF_OPTS[@]}" 2>"$_T_ERR"); RC=$?
cat "$_T_ERR" >&2

if ! jq -e '.results | type == "array"' <<<"$OUT" > /dev/null 2>&1; then
  _fatal "cloudflare-dns exited without a result. (exit code: $RC)" \
    $((RC ? RC : 1)) "$(tail -n 20 "$_T_ERR")"
fi

MSG=$(_build_message "$OUT")
[[ -n "$MSG" ]] && _send_slack "$MSG"
exit $RC


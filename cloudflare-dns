SCRIPT_BASE=`echo $(cd $(dirname $0); pwd)`
SCRIPT_NAME=`basename $0`

RC_FNAME="cloudflare-dns.conf"
# search order: the first one found is loaded
RC_FILES=("./${RC_FNAME}" "${HOME}/.${RC_FNAME}" "/etc/${RC_FNAME}")
# legacy variables which are no longer supported
LEGACY_VARS=(DOMAIN IP_SUPPLIER_SCRIPT IP_PROVIDER_SCRIPT)
CF_API_DEFAULT_BASE="https://api.cloudflare.com/client/v4"

